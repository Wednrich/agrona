{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/*.py": {
      "maxDuration": 180,
      "includeFiles": "{scripts/field_data/**/*.py,workers/hls/worker.py}",
      "excludeFiles": "{tests/**,public/**,dist/**,data/prepared/**,docs/**,supabase/**,workers/hls/test_*.py}"
    }
  },
  "rewrites": [
    { "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }
  ]
}
